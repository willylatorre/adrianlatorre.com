{
  "name": "playground",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "run-p dev:server dev:client",
    "dev:server": ".venv/bin/python3 -m uvicorn server.main:app --reload --host 0.0.0.0 --port 8080",
    "dev:client": "vite --host",
    "dev:full": "run-p dev:server \"dev:client {@}\" --",
    "build": "vite build",
    "preview": "vite preview",
    "start": "python3 -m uvicorn server.main:app --host 0.0.0.0 --port ${PORT:-8080}",
    "test": "vitest run",
    "test:server": ".venv/bin/python3 -m pytest server/tests",
    "type-check": "vue-tsc --build",
    "lint:oxlint": "oxlint . --fix -D correctness --ignore-path .gitignore",
    "lint:eslint": "eslint . --fix",
    "lint": "run-s lint:*",
    "format": "prettier --write src/",
    "types:generate": "echo 'Types are maintained in src/types/api-generated.ts; use /api/openapi.json as the source of truth for larger API changes'",
    "types:check": "echo 'Remember to keep src/types/api-generated.ts aligned with FastAPI models'"
  },
  "dependencies": {
    "@nuxt/ui": "^4.7.1",
    "@tailwindcss/vite": "^4.1.14",
    "@tiptap/core": "^3.22.4",
    "@tiptap/extension-underline": "^3.4.0",
    "@tiptap/starter-kit": "^3.4.0",
    "@tiptap/vue-3": "^3.4.0",
    "@waves-counter/client": "^0.2.2",
    "@waves-counter/vue": "^0.2.2",
    "markdown-it": "^14.1.0",
    "tailwindcss": "^4.1.14",
    "vue": "^3.5.22",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@prettier/plugin-oxc": "^0.1.4",
    "@tsconfig/node22": "^22.0.2",
    "@types/node": "^22.18.6",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^9.33.0",
    "eslint-plugin-oxlint": "~1.70.0",
    "eslint-plugin-vue": "~10.9.0",
    "highlight.js": "^11.11.1",
    "jiti": "^2.5.1",
    "markdown-it-highlightjs": "^4.2.0",
    "npm-run-all2": "^9.0.2",
    "oxlint": "~1.70.0",
    "prettier": "3.8.4",
    "sass-embedded": "^1.93.2",
    "typescript": "~5.9.0",
    "unplugin-vue-markdown": "^32.0.0",
    "vite": "^7.1.7",
    "vite-plugin-vue-devtools": "^8.0.2",
    "vitest": "^4.0.18",
    "vue-tsc": "^3.1.0"
  }
}
